# Copy to .env (next to compose.yaml) and fill in. Keep .env readable only by the admins:
#   chmod 600 .env
# Use letters and digits for the passwords (they go into a database URL), e.g. openssl rand -hex 24

# PostgreSQL superuser (used only by the database container itself)
POSTGRES_PASSWORD=
# The application's own database role ("omop", owner of database "omop", not a superuser)
OMOP_DB_PASSWORD=

# Claude API key, needed for projects with llm.provider: anthropic. Only aggregates are sent.
ANTHROPIC_API_KEY=
# The download link Athena e-mails you (treat it like a password); used by `vocab-download`.
ATHENA_DOWNLOAD_URL=

# Session-signing key for the web app (at least 32 characters, e.g. openssl rand -hex 32).
# Leave empty to have one generated in data/secret_key.
OMOP_AGENT_WEB_SECRET=
# true when users reach the app over HTTPS (through your reverse proxy); strongly recommended.
OMOP_AGENT_SECURE_COOKIES=false
# Address and port the app listens on, on the server. Keep 127.0.0.1 and put an HTTPS
# reverse proxy (nginx, Caddy, IIS) on the same server in front of it.
OMOP_AGENT_BIND=127.0.0.1
OMOP_AGENT_PORT=8000
# Which proxies may report the client's address (used to slow down password guessing).
# "*" is right while OMOP_AGENT_BIND is 127.0.0.1. If you bind to a network address, set it
# to the Docker network gateway your proxy's requests arrive from (docker network inspect).
FORWARDED_ALLOW_IPS=*

# Your user and group ids on the server (id -u / id -g), so files the app writes are yours.
OMOP_AGENT_UID=10001
OMOP_AGENT_GID=10001

# If Docker Hub limits your pulls, use a mirror of the same images, e.g.
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16
