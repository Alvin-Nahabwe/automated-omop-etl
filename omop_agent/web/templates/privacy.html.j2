{% extends "base.html.j2" %}
{% from "_macros.html.j2" import badge, gate_line, approve_form %}
{% block title %}Privacy review · {{ project.name }}{% endblock %}
{% block content %}
<h1>Privacy review</h1>
<p class="sub">What this project sends to Claude. Identifier columns are detected automatically, but the rules can miss a column, so a reviewer checks this before the first call, and again whenever the source or the privacy settings change.</p>

{% if not sends %}
<div class="card"><p>Not needed: this project does not send data to Claude (<code>llm.provider: {{ project.cfg.llm.provider }}</code>).</p></div>
{% elif review is none %}
<div class="card"><p class="muted">The source has not been profiled yet. The first pipeline run profiles it and then stops here for this review, before anything is sent.</p></div>
{% else %}
<section class="card">
  <h2>Review</h2>
  <p>{{ gate_line(gate) }}</p>
  {% if gate.approval and gate.approval.note %}<p class="small">“{{ gate.approval.note }}”</p>{% endif %}
  {% if gate.approval and not gate.current %}<div class="callout">The profile or the privacy settings changed since this was approved, so it needs a new review.</div>{% endif %}
  {{ approve_form('/p/' ~ project.id ~ '/privacy/approve', gate, csrf, 'privacy review', user) }}
</section>

<section class="card">
  <h2>What is sent, and when</h2>
  <p class="small">To <strong>{{ review.provider }}</strong> (model <code>{{ review.model }}</code>). Values seen fewer than {{ review.settings.min_cell_count }} times are never sent{% if not review.settings.send_values_to_llm %}, and no values are sent at all (<code>send_values_to_llm: false</code>){% endif %}.</p>
  <ul>{% for x in review.sent %}<li>{{ x }}</li>{% endfor %}</ul>
</section>

<section class="card">
  <h2>Withheld columns ({{ review.withheld|length }})</h2>
  <p class="small">Claude sees only the counts of these columns, never their values, and they can never be loaded into the CDM.</p>
  {% if review.withheld %}
  <div class="tw"><table>
    <thead><tr><th>Table</th><th>Column</th><th>Why</th></tr></thead>
    <tbody>{% for w in review.withheld %}<tr><td>{{ w.table }}</td><td><code>{{ w.column }}</code></td><td class="small">{{ w.reason }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<div class="callout">No column was flagged. Check the profile below carefully.</div>{% endif %}
  <p class="small">Check the columns that are <em>not</em> listed here too. To withhold another column, add <code>table.column</code> to <code>privacy.pii_columns</code> in <code>omop_agent.yaml</code>; to release one flagged by mistake (for example a CD4 count), add it to <code>privacy.not_pii_columns</code>. Then reload this page.</p>
</section>

<section class="card">
  <h2>The profile exactly as Claude will see it</h2>
  <p class="small">{{ review.tables|length }} tables. Look for names, phone numbers, addresses, local ID numbers or free text among the listed values.</p>
  <pre class="log">{{ review.profile_text }}</pre>
</section>
{% endif %}
{% endblock %}
