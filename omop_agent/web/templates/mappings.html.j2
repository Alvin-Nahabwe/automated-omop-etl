{% extends "base.html.j2" %}
{% from "_macros.html.j2" import badge, gate_line, approve_form %}
{% block title %}Code mappings · {{ project.name }}{% endblock %}
{% macro concept(c, current=false) -%}
<span><strong>{{ c.concept_id }}</strong> {{ c.concept_name }}{% if current %} <span class="badge b-muted">current</span>{% endif %}<br>
<span class="meta">{{ c.vocabulary_id }} · {{ c.domain_id }} · {{ c.concept_class_id }}{% if c.concept_code %} · code {{ c.concept_code }}{% endif %}{% if c.score %} · match {{ '%.2f'|format(c.score) }}{% endif %}</span></span>
{%- endmacro %}
{% block content %}
<h1>Code mappings</h1>
<p class="sub">Each local code, how often it occurs, and the standard concept the model proposed (the Usagi step). Approve it, pick another concept, flag it for discussion, or reject it. Your name and note are saved with every change.</p>

{% if decisions is none %}
<div class="card"><p class="muted">There are no mappings yet. A pipeline run maps the codes once the ETL design is approved.</p></div>
{% else %}

<section class="card">
  <h2>Review</h2>
  <p>{{ gate_line(gate) }}</p>
  <div class="stats">
    <div class="stat"><div class="v">{{ counts.review }}</div><div class="k">need review</div></div>
    <div class="stat"><div class="v">{{ counts.approved }}</div><div class="k">approved</div></div>
    <div class="stat"><div class="v">{{ counts.unmapped }}</div><div class="k">without a concept</div></div>
    <div class="stat"><div class="v">{{ counts.rejected }}</div><div class="k">rejected</div></div>
    <div class="stat"><div class="v">{{ counts.all }}</div><div class="k">in total{% if vocab %} in {{ vocab }}{% endif %}</div></div>
  </div>
  {% if changes %}
    <div class="callout">{{ changes|length }} mapping(s) changed since the last approval:
      <ul class="small">{% for c in changes[:12] %}<li><code>{{ c.source_vocabulary_id }}</code> {{ c.source_code }}:
        {% if c.before %}{{ c.before.target_concept_id }} ({{ c.before.status|lower }}){% else %}new{% endif %} →
        {% if c.after %}{{ c.after.target_concept_id }} ({{ c.after.status|lower }}){% else %}removed{% endif %}</li>{% endfor %}
        {% if changes|length > 12 %}<li>… and {{ changes|length - 12 }} more</li>{% endif %}</ul></div>
  {% endif %}
  {% if gate.ready and not gate.current and counts.review %}
    <p class="small">{{ counts.review }} mapping(s) still need review.
    {% if include_unchecked %}If you approve now, unchecked mappings are used in the ETL as the model proposed them; flagged ones are left out.
    {% else %}Unchecked and flagged mappings are left out of the ETL until approved.{% endif %}</p>
  {% endif %}
  {{ approve_form('/p/' ~ project.id ~ '/mappings/approve', gate, csrf, 'code mappings', user) }}
</section>

{% if busy %}<div class="callout">A pipeline run is in progress. You can read the mappings, but edits are paused until it finishes.</div>{% endif %}
{% if not db_ok %}<div class="callout">The vocabulary database cannot be reached right now. You can approve, flag or reject, but not search the vocabulary or choose a concept that is not listed.</div>{% endif %}

<form method="get" action="/p/{{ project.id }}/mappings" class="filters">
  <input type="hidden" name="filter" value="{{ filter }}">
  <label class="inline" for="vocab">Source vocabulary</label>
  <select id="vocab" name="vocab">
    <option value="" {% if not vocab %}selected{% endif %}>All</option>
    {% for v in vocabs %}<option value="{{ v }}" {% if v == vocab %}selected{% endif %}>{{ v }}</option>{% endfor %}
  </select>
  <button class="btn quiet" type="submit">Show</button>
</form>
<nav class="filters" aria-label="Filter">
  {% for key, label in filters.items() %}
  <a href="?filter={{ key }}{% if vocab %}&amp;vocab={{ vocab|urlencode }}{% endif %}" aria-current="{{ 'true' if key == filter else 'false' }}">{{ label }} ({{ counts[key] }})</a>
  {% endfor %}
</nav>

{% if not decisions %}
<div class="card"><p class="muted">Nothing here{% if filter == 'review' %}: every mapping in this view has been reviewed{% endif %}.</p></div>
{% else %}
<div class="terms">
  <div class="term-head"><span>Status</span><span>Source code</span><span class="n">Records</span><span>Standard concept</span><span class="n">Conf.</span></div>
  {% for d in decisions %}
  {% set aid = anchor(d.source_vocabulary_id, d.source_code) %}
  {% set is_open = open_term is not none and open_term.source_code == d.source_code and open_term.source_vocabulary_id == d.source_vocabulary_id %}
  <details class="term" id="{{ aid }}" {% if is_open %}open{% endif %}>
    <summary>
      <span>{{ badge(d.status|lower) }}</span>
      <span><span class="code">{{ d.source_code }}</span>{% if d.source_name and d.source_name != d.source_code %}<br><span class="muted small">{{ d.source_name }}</span>{% endif %}
        {% if not vocab %}<br><span class="muted small">{{ d.source_vocabulary_id }}</span>{% endif %}
        <span class="muted small show-sm">{{ '{:,}'.format(d.frequency) }} records</span></span>
      <span class="n hide-sm">{{ '{:,}'.format(d.frequency) }}</span>
      <span class="target">{% if d.target_concept_id %}<strong>{{ d.target_concept_id }}</strong> {{ d.target_concept_name or '' }}<br><span class="muted small">{{ d.target_vocabulary_id or '' }} · {{ d.target_domain_id or '' }}</span>{% else %}<span class="muted">no standard concept</span>{% endif %}</span>
      <span class="n hide-sm">{{ '%.2f'|format(d.confidence) }}</span>
    </summary>
    <div class="term-body">
      <div>
        <h3>Why</h3>
        <p class="why small">{{ d.rationale or '—' }}</p>
        <dl class="facts small">
          <dt>Method</dt><dd>{{ d.method }}</dd>
          <dt>Equivalence</dt><dd>{{ d.equivalence|lower }}</dd>
          {% if d.target_domain %}<dt>Target domain</dt><dd>{{ d.target_domain }}{% if d.accepted_domains|length > 1 %} <span class="muted small">(also accepted: {{ d.accepted_domains[1:]|join(', ') }}; the record moves to the table of the concept's domain)</span>{% endif %}</dd>{% endif %}
          {% if d.reviewed_by %}<dt>Reviewed</dt><dd>{{ d.reviewed_by }}, {{ d.reviewed_at|dt }}</dd>{% endif %}
          {% if d.review_note %}<dt>Reviewer's note</dt><dd>{{ d.review_note }}</dd>{% endif %}
        </dl>
      </div>
      <div>
        {% if user.can('reviewer') and not busy %}
        {% if db_ok %}
        <form method="get" action="/p/{{ project.id }}/mappings#{{ aid }}" class="row">
          <input type="hidden" name="filter" value="{{ filter }}">
          {% if vocab %}<input type="hidden" name="vocab" value="{{ vocab }}">{% endif %}
          <input type="hidden" name="page" value="{{ page }}">
          <input type="hidden" name="term" value="{{ aid }}">
          <input type="search" name="q" value="{{ q if is_open else '' }}" placeholder="Search {{ d.target_domain or 'the vocabulary' }}" aria-label="Search the vocabulary for {{ d.source_code }}">
          <button class="btn quiet" type="submit">Search</button>
        </form>
        {% endif %}
        {% if is_open and search_error %}<p class="small">{{ search_error }}</p>{% endif %}
        <form method="post" action="/p/{{ project.id }}/mappings/decide">
          <input type="hidden" name="csrf_token" value="{{ csrf }}">
          <input type="hidden" name="vocab_id" value="{{ d.source_vocabulary_id }}">
          <input type="hidden" name="code" value="{{ d.source_code }}">
          <input type="hidden" name="expected_target" value="{{ d.target_concept_id }}">
          <input type="hidden" name="expected_status" value="{{ d.status }}">
          <input type="hidden" name="back_filter" value="{{ filter }}">
          <input type="hidden" name="back_vocab" value="{{ vocab }}">
          <input type="hidden" name="back_page" value="{{ page }}">
          {% if is_open and search_results is not none and not search_results %}<p class="muted small">No standard concept matches that search.</p>{% endif %}
          <ul class="choices">
            {% for c in choices(d) %}
              <li><label><input type="radio" name="concept_id" value="{{ c.concept_id }}" {% if c.concept_id == d.target_concept_id %}checked{% endif %}> {{ concept(c, c.concept_id == d.target_concept_id) }}</label></li>
            {% endfor %}
            <li><label><input type="radio" name="concept_id" value="0" {% if not d.target_concept_id %}checked{% endif %}> <span>No standard concept fits <span class="meta">(the records keep concept 0)</span></span></label></li>
          </ul>
          <label for="note-{{ aid }}">Note (optional)</label>
          <textarea id="note-{{ aid }}" name="note" maxlength="1000">{{ d.review_note }}</textarea>
          <div class="row">
            <button class="btn primary" type="submit" name="action" value="approve">Approve selection</button>
            <button class="btn" type="submit" name="action" value="flag">Flag for discussion</button>
            <button class="btn danger" type="submit" name="action" value="reject" data-confirm="Reject this mapping? Its records will not be mapped.">Reject</button>
          </div>
        </form>
        {% elif d.candidates %}
          <h3>Other candidates</h3>
          <ul class="choices">{% for c in d.candidates %}<li>{{ concept(c, c.concept_id == d.target_concept_id) }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
    </div>
  </details>
  {% endfor %}
</div>
{% if pages > 1 %}
<nav class="pager" aria-label="Pages">
  {% if page > 1 %}<a class="btn quiet" href="?filter={{ filter }}{% if vocab %}&amp;vocab={{ vocab|urlencode }}{% endif %}&amp;page={{ page - 1 }}">Previous</a>{% endif %}
  <span class="muted small">Page {{ page }} of {{ pages }} · {{ total }} codes</span>
  {% if page < pages %}<a class="btn quiet" href="?filter={{ filter }}{% if vocab %}&amp;vocab={{ vocab|urlencode }}{% endif %}&amp;page={{ page + 1 }}">Next</a>{% endif %}
</nav>
{% endif %}
{% endif %}
{% endif %}
{% endblock %}
